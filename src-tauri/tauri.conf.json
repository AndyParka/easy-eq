{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy EQ",
  "version": "0.1.0",
  "identifier": "technology.parkinson.peace2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Easy EQ", "visible": false, "width": 1330, "height": 950, "minWidth": 760, "minHeight": 700 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420" }
  },
  "bundle": { "active": false }
}
